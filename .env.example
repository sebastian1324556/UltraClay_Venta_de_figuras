# ===============================================================
# VARIABLES DE ENTORNO · ULTRA M 64
# Cópialas en Cloudflare Pages > Settings > Environment variables
# (Production y Preview). NUNCA subas el archivo .env real a internet.
# ===============================================================

# --- Turso (base de datos) ---------------------------------------
# URL de la base de datos, ej: libsql://ultram64-tu-usuario.turso.io
TURSO_DATABASE_URL=libsql://REEMPLAZAR-tu-base.turso.io
# Token de la base de datos (turso db tokens create <nombre>)
TURSO_AUTH_TOKEN=REEMPLAZAR_TOKEN_TURSO

# --- Administrador inicial ----------------------------------------
# Se crea automáticamente la primera vez que se usa la página.
# Cambia la contraseña por una segura antes de publicar.
ADMIN_EMAIL=tu-correo@ejemplo.com
ADMIN_PASSWORD=REEMPLAZAR_CONTRASENA_SEGURA

# --- Nequi (opcional, para cuando tengas las credenciales) --------
NEQUI_CLIENT_ID=
NEQUI_CLIENT_SECRET=
NEQUI_API_KEY=
